# Railway-en ezeket a "Variables" fülön kell beállítani!
# Helyi fejlesztéshez másold ezt .env fájlba és töltsd ki

# Discord bot token (kötelező)
DISCORD_TOKEN=

# Discord szerver ID
GUILD_ID=1059572724617465926

# PostgreSQL kapcsolati string (Railway automatikusan adja)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT titkos kulcs — változtasd meg valami egyedire!
JWT_SECRET=valami-nagyon-titkos-kulcs-itt-2024

# Szerver port (Railway automatikusan beállítja)
PORT=3000

# Stáb szerepek JSON formátumban (Railway Variables-ben is beállítható)
STAFF_ROLES=[{"id":"1059589453267603527","name":"Tulajdonos"},{"id":"1326226291766198362","name":"Server Manager"},{"id":"1403049001820880938","name":"Community Manager"},{"id":"1374338786602913802","name":"Staff Manager"},{"id":"1401175109133271200","name":"Senior Support"},{"id":"1398799869262696499","name":"Support+"},{"id":"1479202768483909692","name":"Discord Supervisor"},{"id":"1272637555103367260","name":"Support"},{"id":"1363193143146713098","name":"Junior Support"}]
